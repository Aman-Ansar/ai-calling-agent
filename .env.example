# --- Twilio (calling) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+100000"
TWILIO_WHATSAPP_NUMBER="+100000"
NGROK_URL=""

# --- OpenAI (conversation AI) ---
OPENAI_API_KEY=""

# --- LLM Provider: "openai" or "qwen" ---
# Set to "qwen" to use Alibaba Cloud DashScope (Qwen) instead of OpenAI
LLM_PROVIDER="openai"

# --- Qwen / Alibaba Cloud Model Studio (only needed if LLM_PROVIDER=qwen) ---
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# --- MongoDB (data storage) ---
MONGODB_URI=""

# --- ElevenLabs (bilingual text-to-speech) ---
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID_EN=""
ELEVENLABS_VOICE_ID_AR=""

# --- Backend team contacts (where leads/complaints get sent) ---
LEASING_TEAM_EMAIL="leasing@daralshuwaikhmall.com"
LEASING_TEAM_PHONE="+96500000000"
OPERATIONS_TEAM_EMAIL="operations@daralshuwaikhmall.com"
OPERATIONS_TEAM_PHONE="+96500000000"
DUTY_MANAGER_PHONE="+96500000000"

# --- SMTP (for sending the email notifications above) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="A5 Mall AI Assistant"

PERSONAL_PHONE="+10000000"
FLASK_APP=app.py
FLASK_ENV=development
